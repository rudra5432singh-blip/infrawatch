# ==============================================
#   INFRAWATCH - Production .gitignore
# ==============================================

# --- Secrets & Environment Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Python & Backend Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Local Databases & SQLite Locks ---
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# (infrawatch.db is auto-generated via `python data/seed.py`)
backend/infrawatch.db

# --- Frontend & Node.js Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.npm
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating System & Editor Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Code Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# --- Temporary & Scratch Directories ---
scratch/
tmp/
temp/
*.log
